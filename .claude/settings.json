{
	"permissions": {
		"defaultMode": "default",
		"allow": [
			"Bash(npm test)",
			"Bash(npm run*)",
			"Bash(npx playwright*)",
			"Bash(npx astro*)",
			"Bash(npx biome*)",
			"Bash(git status)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git add*)",
			"Bash(git commit*)",
			"Bash(git branch*)",
			"Bash(git checkout*)",
			"Bash(git switch*)"
		],
		"ask": [
			"Bash(git push*)",
			"Bash(git reset --hard*)"
		],
		"deny": [
			"Write(*.env)",
			"Write(.env.*)",
			"Edit(*.env)",
			"Edit(.env.*)",
			"Edit(.git/*)",
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.development)",
			"Read(./.env.production)",
			"Read(./.env.staging)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.mjs"] }
				]
			}
		]
	},
	"extraKnownMarketplaces": {
		"codelife-pinned": {
			"source": {
				"source": "settings",
				"name": "codelife-pinned",
				"plugins": [
					{
						"name": "pstack",
						"description": "cursor/plugins の pstack（Claude Code版）。commit固定。更新はAGENTS.md「開発スキル（pstack）」に従う",
						"source": {
							"source": "git-subdir",
							"url": "https://github.com/cursor/plugins.git",
							"path": "harness/pstack/claude-code",
							"sha": "e73df471cd4bd918367e99f3dd9c51bd53ddf5f0"
						}
					}
				]
			}
		}
	},
	"enabledPlugins": {
		"pstack@codelife-pinned": true
	}
}
