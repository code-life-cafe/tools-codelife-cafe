---
import { getEntry } from 'astro:content';
import ToolLayout from '../components/tool/ToolLayout.astro';
import Bookmarklet from '../components/tools/Bookmarklet.tsx';

const toolEntry = await getEntry('tools', 'bookmarklet');
if (!toolEntry) {
  throw new Error('Tool entry not found: bookmarklet');
}
---

<ToolLayout tool={toolEntry}>
  <Bookmarklet client:load />
</ToolLayout>
