---
import { getEntry } from 'astro:content';
import ToolLayout from '../components/tool/ToolLayout.astro';
import { PasswordGenerator } from '../components/tools/PasswordGenerator';

const toolEntry = await getEntry('tools', 'password-generator');
if (!toolEntry) {
  throw new Error('Tool entry not found: password-generator');
}
---

<ToolLayout tool={toolEntry}>
  <PasswordGenerator client:load />
</ToolLayout>
