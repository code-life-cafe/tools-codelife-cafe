---
import { getEntry } from 'astro:content';
import ToolLayout from '../components/tool/ToolLayout.astro';
import UrlParserTool from '../components/tools/UrlParser.tsx';

const toolEntry = await getEntry('tools', 'url-parser');
if (!toolEntry) {
  throw new Error('Tool entry not found: url-parser');
}
---

<ToolLayout tool={toolEntry}>
  <UrlParserTool client:load />
</ToolLayout>
