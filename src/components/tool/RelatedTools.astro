---
import { ClipboardList } from 'lucide-react';
import { getRelatedTools, toolCatalog, type ToolCatalogItem } from '../../lib/tools/catalog';
import { getWorkflowContext } from '../../lib/tools/workflow-sets';
import ToolCard from '../common/ToolCard.astro';

interface Props {
	toolId?: string;
	relatedSlugs?: string[];
	excludeIds?: string[];
}

const { toolId, relatedSlugs, excludeIds = [] } = Astro.props;

// ワークフローコンテキストの取得
const workflowCtx = toolId ? getWorkflowContext(toolId) : null;

// ワークフロー内の他ステップを関連ツールリンクとして表示（現在のツールは除外）
const relatedWorkflowSteps = workflowCtx
	? workflowCtx.allSteps
			.map((step, position) => ({ step, position }))
			.filter(({ step }) => step.id !== toolId)
	: [];

// ワークフロー導線で既に表示済みのツールIDを除外対象に含める
const excludeSet = new Set(excludeIds);

// frontmatter の related を最優先し、不足分だけ catalog.ts の同カテゴリ補完を使う
const LIMIT = 3;
let validTools: ToolCatalogItem[] = [];
const seen = new Set<string>();

const normalizeSlug = (slug: string) => slug.replace(/^\//, '').replace(/^tools\//, '');
const findBySlug = (slug: string) => {
	const normalized = normalizeSlug(slug);
	return toolCatalog.find((t) => t.id === normalized || t.href === `/${normalized}` || t.href === `/tools/${normalized}`);
};
const pushTool = (tool: ToolCatalogItem | undefined) => {
	if (!tool || tool.id === toolId || seen.has(tool.id) || excludeSet.has(tool.id) || validTools.length >= LIMIT) return;
	seen.add(tool.id);
	validTools.push(tool);
};

for (const slug of relatedSlugs ?? []) {
	pushTool(findBySlug(slug));
}

if (toolId && validTools.length < LIMIT) {
	for (const tool of getRelatedTools(toolId, LIMIT)) {
		pushTool(tool);
	}
} else if (!toolId && validTools.length === 0 && relatedSlugs && relatedSlugs.length > 0) {
	const found = findBySlug(relatedSlugs[0]);
	if (found) validTools = getRelatedTools(found.id, LIMIT);
}
---

{workflowCtx ? (
	<section id="related-tools-section" class="mt-8 rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs" aria-labelledby="related-tools-heading">
		<div class="mb-4">
			<h2 id="related-tools-heading" class="text-lg font-bold text-foreground flex items-center gap-2 mb-1.5">
				<ClipboardList className="h-5 w-5 text-primary" aria-hidden="true" />
				この作業の続きに
			</h2>
			<p class="text-sm text-muted-foreground leading-relaxed">
				{workflowCtx.set.description}
			</p>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{relatedWorkflowSteps.map(({ step, position }) => (
				<div data-track-related-click data-from={toolId ?? ''} data-to={step.id} data-set-id={workflowCtx.set.id} data-position={position}>
					<ToolCard
						id={step.id}
						title={step.title}
						description={step.description}
						href={step.href}
						icon={step.icon}
						categories={step.categories.map((c) => ({ name: c }))}
					/>
				</div>
			))}
		</div>
	</section>
) : (
	validTools.length > 0 && (
		<section id="related-tools-section" class="mt-8" aria-labelledby="related-tools-heading">
			<div class="mb-4">
				<h2 id="related-tools-heading" class="text-lg font-semibold text-foreground">
					あわせて使いたいツール
				</h2>
				<p class="text-sm text-muted-foreground leading-relaxed mt-0.5">
					現在の作業と組み合わせて使うことで、より効率的に作業を行えるおすすめのツールです。
				</p>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{validTools.map((t, i) => (
					<div data-track-related-click data-from={toolId ?? ''} data-to={t.id} data-position={i}>
						<ToolCard
							id={t.id}
							title={t.title}
							description={t.description}
							href={t.href}
							icon={t.icon}
							categories={t.categories.map((c) => ({ name: c }))}
						/>
					</div>
				))}
			</div>
		</section>
	)
)}

<script>
	import { track } from '../../lib/analytics';

	document.addEventListener('click', (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track-related-click]');
		if (!el) return;
		const from = el.dataset.from ?? '';
		const to = el.dataset.to ?? '';
		const setId = el.dataset.setId;
		const position = parseInt(el.dataset.position ?? '0', 10);
		
		if (from && to && !Number.isNaN(position)) {
			track('related_click', { from, to, setId, position });
		}
	});
</script>
